[Unit]
Description=TradingAgents web dashboard (Streamlit, localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
Environment=TZ=Asia/Taipei
Environment=PYTHONUNBUFFERED=1
# Bound to 127.0.0.1: reach it through an SSH tunnel, never directly.
ExecStart=@APP_DIR@/.venv/bin/streamlit run webapp/app.py --server.address 127.0.0.1 --server.port @PORT@ --server.headless true
Restart=on-failure
RestartSec=10
# Background jobs started from the page are children of this service;
# keep them running when the web process restarts.
KillMode=process

[Install]
WantedBy=multi-user.target
